OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8000/webhooks/stripe` or Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# The GPT-5 family uses controls such as reasoning_effort and verbosity instead of allowing to tune with temperature.
# Attempting to set a non-default temperature on GPT-5 models will result in an "Unsupported parameter" error.
# Use any of the following models instead:
# - gpt-4.1
# - gpt-4.1-mini
# - gpt-4.1-nano
# - gpt-4o
# - gpt-4o-mini
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

TEMPERATURE=0.7

DATABASE_URL=postgresql://shop:shop@localhost:5432/shopagent
